# NeedPips Terminal Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Supabase PostgreSQL Connection String (Transaction Pooler)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true

# Supabase Client SDK
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Market News Feed Settings
MARKET_NEWS_POLL_INTERVAL_SEC=60

# SMTP Email Configuration (Optional - for Passcode/Alert verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="NeedPips Security <your_email@gmail.com>"
